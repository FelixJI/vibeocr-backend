{
  "schema_version": 4,
  "flow_version": "4.0.0",
  "repository": "FelixJI/vibeocr-backend",
  "default_branch": "main",
  "mode": "manual-handoff",
  "profile": "balanced",
  "worker_tool": "glm",
  "control": {
    "cross_tool_start": "human",
    "technical_owner": "codex",
    "worker_may_pick_next_task": false,
    "automatic_external_agent_calls": false,
    "automatic_review_subagent": true,
    "automatic_resume": false,
    "progress_polling": false,
    "same_actor_continuation": true,
    "self_handoff_allowed": false,
    "stage_boundary_alone_stops_execution": false
  },
  "work_scope": {
    "default": "one-authorized-stage",
    "max_active_writers_per_repository": 1,
    "stacked_prs_default": false
  },
  "planning": {
    "issue_routing_fields_required": true,
    "goal_routing_summary_required": true,
    "recommended_implementers": ["Codex", "GLM", "Codex-first -> GLM"],
    "codex_must_recalibrate_before_execution": true
  },
  "validation": {
    "commands": ["uv run --no-sync powershell -NoProfile -File scripts/check-quality.ps1", "uv run --no-sync python scripts/check_runtime_protocol_conformance.py"],
    "required_check_names": ["required"]
  },
  "risk_paths": {
    "review_required": ["packages/vibeocr-backend/src/vibeocr/backend/runtime_installer.py", "packages/vibeocr-backend/src/vibeocr/backend/runtime_selection.py", "packages/vibeocr-backend/runtime-profiles", "release/protocol.lock.json"],
    "human_merge_required": ["*"]
  },
  "review": {
    "mode": "codex-review-subagent",
    "automatic_from_codex": true,
    "fresh_subagent_required": true,
    "read_only": true,
    "implementation_edits_forbidden": true,
    "bind_head_and_base_sha": true,
    "new_commit_requires_recheck": true
  },
  "merge": {"mode": "human-only", "automatic": false},
  "deployment": {"authorized": false, "real_data_operations_authorized": false},
  "retry_policy": {"glm_same_root_cause_failed_rounds": 2, "codex_same_root_cause_failed_rounds": 2, "ci_infrastructure_retries": 1},
  "artifact_policy": {"task_and_handoff": "github_issue", "code_test_review": "github_pr", "local_diagnostics": ".ai-flow/runtime/", "checkpoint_report_commits": false}
}
