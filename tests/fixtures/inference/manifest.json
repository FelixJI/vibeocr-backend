{
  "version": 1,
  "description": "Fixed inference test corpus for the unified supervisor rewrite. Fixtures are referenced by golden/contract/benchmark/E2E tests; their paths and semantics must remain stable across releases. Add new fixtures only by appending entries — never rename or delete an existing id without bumping `version`.",
  "images": [
