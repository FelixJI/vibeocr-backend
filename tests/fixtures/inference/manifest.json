    {
      "id": "img-large-formula",
      "path": "tests/fixtures/inference/images/large-formula.png",
      "category": ["large", "formula"],
      "description": "Large image containing mathematical formulas."
    },
    {
      "id": "img-structured-doc",
      "path": "tests/fixtures/inference/images/structured-doc.png",
      "category": ["medium", "structured"],
      "description": "Medium structured document (mixed headings/paragraphs/lists)."
    },
    {
      "id": "img-corrupt",
      "path": "tests/fixtures/inference/images/corrupt.png",
