  "benchmark_matrix": {
    "paddle": {
      "pipelines": ["OCR", "PP-StructureV3", "PaddleOCR-VL", "table", "formula"],
      "devices": ["cpu", "gpu-low-vram", "gpu-mid-vram", "gpu-high-vram"],
      "batch_sweep": [1, 2, 4, 8, 16, 32],
      "warm_cold": ["cold", "warm"]
    },
    "mineru": {
      "backends": ["hybrid-engine", "vlm-engine", "pipeline"],
      "axes": ["doc_count", "total_bytes", "total_pages", "mixed_and_corrupt"],
      "strategies": ["per_file", "budgeted_multi_file", "chunked"]
